{
  "schema": "bass-he.b3.export-contract.v1",
  "request_schema": "bass-he.atomic-request.v1",
  "required_fields": [
    "schema",
    "source_id",
    "temperature_K",
    "distribution",
    "isotope_basis",
    "initial_state",
    "relative_drift_m_s",
    "radiation_model",
    "acknowledge_source_conflict",
    "unit",
    "quantity"
  ],
  "allowed_quantities": [
    "thermal_rate",
    "event_count_coefficients"
  ],
  "temperature_batch_max": 4096,
  "source_default": null,
  "automatic_source_selection": false,
  "available_fit": "GM25_W82_RCX_CONSTANT_200_10000_K_V1",
  "not_a_provider": "WEST82_OPTICAL_REFERENCE_V2",
  "rate_unit": [
    "m3 s-1",
    "cm3 s-1"
  ],
  "exact_source_core_preserved": true,
  "null_moments": [
    "heat",
    "recoil",
    "photon_energy",
    "photon_spectrum",
    "inverse_rate",
    "source_uncertainty"
  ],
  "quantity_semantics": "coefficients only; no density product or gas evolution",
  "validator": "whole selected-code replay; not signature/physics proof",
  "double_count_rule": "one provider per reaction; rate/count are views not separate reactions",
  "allowed_consumer_hint": "rei_bianchi; no integration claim",
  "precision_policy": {
    "rate": "binary64 view + decimal tokens",
    "fast_math": false,
    "reassociation": false,
    "hidden_mixed_precision": false
  }
}
