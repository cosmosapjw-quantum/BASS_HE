zeroQ[z_] := And @@ (TrueQ[Together[#] === 0] & /@ Flatten[{z}]);
vars={xx,aa,bb,ww}; ee=xx+ff(aa+2bb); dd=1+ff+ee;
temp=tau ww/dd; rrho=rhostar(temp/tstar)^2;
drate=nh ff bb ee rrho;
gas={otherH,otherHe1+rr2/ff,otherHe2-rr2/ff};
heat=otherHeat-kin2; escape=otherEscape+chi2 rr2+kin2;
fv={xx-xold,aa-aold,bb-bold}-hh gas;
fw=ww-wold-hh heat+2hh hub ww;
fe=(1+2hh hub)ww-wold+deltaBinding+hh escape-absorbedEnergy;
full=Join[fv,{fw}]; cons=Join[fv,{fe}];
rules={rr2->rr2+drate,kin2->kin2+eta drate};
shift=(full/.rules)-full; shiftE=(cons/.rules)-cons;
expected=hh drate{0,-1/ff,1/ff,eta};
expectedE=hh drate{0,-1/ff,1/ff,chi2+eta};
directResidual=zeroQ[shift-expected];
directConservative=zeroQ[shiftE-expectedE];
directEscape=zeroQ[(escape/.rules)-escape-(chi2+eta)drate];
firstThermal=zeroQ[D[shift[[4]],ww]-2hh eta drate/ww];
secondThermal=zeroQ[D[shift[[4]],ww,ww]-2hh eta drate/ww^2];
firstSpecies=zeroQ[Table[D[shift[[i]],ww],{i,3}]-2hh drate{0,-1/ff,1/ff}/ww];
pref=nh ff rhostar(tau/tstar)^2;
aaPop=bb ee; aaGrad=Table[D[aaPop,vars[[i]]],{i,3}];
aaHess=Table[D[aaPop,vars[[i]],vars[[j]]],{i,3},{j,3}];
tv={1,ff,2ff};
gradChem=Table[pref ww^2/dd^2(aaGrad[[i]]-2aaPop tv[[i]]/dd),{i,3}];
hessChem=Table[pref ww^2/dd^2(aaHess[[i,j]]-2(aaGrad[[i]]tv[[j]]+aaGrad[[j]]tv[[i]])/dd+6aaPop tv[[i]]tv[[j]]/dd^2),{i,3},{j,3}];
gradCheck=zeroQ[Table[D[drate,vars[[i]]],{i,3}]-gradChem];
hessCheck=zeroQ[Table[D[drate,vars[[i]],vars[[j]]],{i,3},{j,3}]-hessChem];
mixedCheck=zeroQ[Table[D[drate,vars[[i]],ww],{i,3}]-2gradChem/ww];
checks=<|"direct_primitive_residual_shift"->directResidual,"direct_conservative_shift"->directConservative,"direct_escape_shift"->directEscape,"thermal_w_derivative"->firstThermal,"thermal_ww_derivative"->secondThermal,"species_w_derivative"->firstSpecies,"chemical_gradient"->gradCheck,"chemical_hessian"->hessCheck,"mixed_temperature_chemical_hessian"->mixedCheck|>;
ExportString[<|"unit"->"HERE_RUX03_PRIMARY_THEORY_03","engine"->$Version,"kind"->"exact symbolic temperature-dependent channel perturbation","group_count"->Length[checks],"checks"->checks,"all_pass"->And@@Values[checks],"reason"->"Independent review R6: constant coefficient perturbation alone does not test kinetic-coefficient temperature derivatives."|>,"RawJSON"]
