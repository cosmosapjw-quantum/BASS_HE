{
  "inputs": {
    "Rice_sigma": {
      "data_kind": "source_experiment_bin_fit_as_pointwise_model",
      "unit": "nb",
      "E_range_MeV": [
        150,
        250
      ],
      "campaigns": 1
    },
    "cosmology": {
      "source": "Planck PDG PR131 baseline",
      "temperature": "K",
      "densities": "cm^-3",
      "H": "s^-1",
      "frame": "comoving local alpha-rest"
    }
  },
  "outputs": {
    "CROSS_SECTIONS_MODEL_5.csv": {
      "count": 5,
      "units": "cm^2 per electron/ion and event; E in MeV",
      "class": "model_coefficients"
    },
    "LOCAL_FOUR_CHANNEL_HAZARDS_18.csv": {
      "count": 18,
      "units": "s^-1; H s^-1",
      "class": "model_local_collision_hazards"
    },
    "COSMIC_FIRST_COLLISION_18.csv": {
      "count": 18,
      "units": "probabilities dimensionless; born kinetic energy MeV per injected gamma",
      "class": "model_first_collision_green_function",
      "P_reached_150_MeV_unhit": "null if tau=65 reached before reaching E=150",
      "P_unresolved_survival_upper_bound": "exp(-65) when truncated early, not observed survival to E150"
    }
  },
  "excluded": [
    "photoproduction source emissivity",
    "gamma e triplet pair",
    "He gamma other exclusive channels",
    "KN scattered photon recycling",
    "BH e\u00b1 cascade",
    "fast D plasma thermal deposition",
    "non-FLRW anisotropic photon transport",
    "measured per-energy Rice excitation function"
  ]
}
